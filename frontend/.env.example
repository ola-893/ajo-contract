# Starknet Network Configuration
# Options: sepolia, mainnet, devnet
VITE_STARKNET_NETWORK=sepolia

# Optional: WalletConnect Project ID for enhanced wallet connection
# Get one at: https://cloud.walletconnect.com/
VITE_WALLET_CONNECT_PROJECT_ID=

# Contract Addresses
VITE_AJO_FACTORY_ADDRESS=

# Optional explicit RPC override (recommended for starknet.js v6: use a v0_7 endpoint)
VITE_STARKNET_RPC_URL=
